<!DOCTYPE html>
<html lang="en-GB">

    <head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
    <title>Main Screen</title>
    
    </head>

    <script>

        $(document).ready(function () {
            $('#transactionsTable').DataTable();
        });

    </script>

    <body>

        <div id="main-screen">

            <button id="menu-btn" onclick="toggleMenu()">O</button>

            <div id="sidebar" class="sidebar">

                <button id="close-btn" onclick="toggleMenu()">✖</button>

                <form action="/logout" method="POST">
                    <button type="submit">Logout</button>
                </form>

                <form action="/settings" method="GET">
                    <BUTTON type="submit">Settings</BUTTON>
                </form>

                <% if (accountType === 'parent') { %>
                    <form action="/create-child" method="GET">
                        <button type="submit"> Create Child Account</button>
                    </form>
                <% } %> <!-- Prevents account from seeing this, if not parent account.-->

            </div>

            <h2>Welcome, <%= userName %>!</h2>

            <div class="card-viewer">

                <div id="card-container">

                    <% if (!cards || cards.length === 0) { %>
                        <p>No cards available</p>
                    <% } else { %>

                        <div class="card">

                            <h3>£<%= (cards[0].money / 100).toFixed(2) %></h3> <!-- fixes to 2 decimal point-->
                            <p class="card-number"><%= cards[0].number %></p>
                            <p><%= cards[0].name %></p>
                            <p>Expiry: <%= cards[0].expiry %></p>
                        </div>

                    <% } %>

                </div>

                <table id="transactionsTable">
                    <thead>
                        <tr>

                            <th> Type </th>
                            <th> Other User </th>
                            <th> Amount </th>
                            <th> Date </th>

                        </tr>
                    </thead>

                        <tbody> <!-- Table Body Starts -->
                        <% transactions.forEach(t => { %> <!-- Loops code for each transaction.-->
                            <tr> <!-- Table Row -->
                                <td>
                                <% if (t.from_name === userName) { %> <!-- Says who sent money.-->
                                    Sent
                                <% } else { %>
                                    Received
                                <% } %> <!-- Tells if Money was Sent/Received-->
                                </td>

                                <td>
                                <% if (t.from_name === userName) { %> <!-- Shows receiver/sender -->
                                    <%= t.to_name %>
                                <% } else { %>
                                    <%= t.from_name %>
                                <% } %>
                                </td>

                                <td>£<%= (t.amount / 100).toFixed(2) %></td> <!-- Amount sent.-->
                                <td><%= t.created_at %></td> <!-- Date the transaction was received/created-->

                            </tr>

                        <% }) %>

                    </tbody> <!-- Table Body Ends-->

                </table>

            </div>

        </div>

        <script src="/js/main.js"></script>

    </body>
    
</html>